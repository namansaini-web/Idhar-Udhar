rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Test connection doc
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Campus Marketplace Listings
    match /listings/{listingId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.sellerId == request.auth.uid || request.auth.uid == request.resource.data.sellerId);
    }

    // Urgent Hostel Requests ("Request Daalna")
    match /requests/{requestId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.requesterId == request.auth.uid || request.auth.uid == request.resource.data.requesterId);
    }

    // Campus Handover Sessions
    match /exchanges/{exchangeId} {
      allow read, write: if request.auth != null;
    }

    // Chat Threads & Messages
    match /threads/{threadId} {
      allow read, write: if request.auth != null;

      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
